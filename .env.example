# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Required — change before deploying
DB_PASSWORD=changeme

# Application settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Database URL (constructed from DB_PASSWORD above in docker-compose.yml)
# Set directly if running outside Docker Compose:
# DATABASE_URL=postgresql://apex:changeme@localhost:5432/apex_db

# Image tag for docker-compose (defaults to "latest")
# IMAGE_TAG=abc1234
